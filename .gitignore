# Python virtual environment used by convert.py - large and fully
# regeneratable (pip install -r requirements / see README for setup steps).
venv/

# Magpie's own runtime state - shader compile cache and rolling log file.
# Ephemeral, regenerated automatically on each run.
Magpie/cache/
Magpie/logs/

# Transient debug output from the PowerShell scripts in 4K-TV-Setup/ and
# tools/ - regenerated fresh on every run, meaningless once stale.
4K-TV-Setup/*.log
tools/*.log
tools/.tv-infra-status.json
tools/.tv-mode-action

# Quality-test screenshots - copyrighted comic art, kept local only.
tools/quality-test/captures/

__pycache__/
*.pyc

# Extracted copy of the VDD Control app (163 MB, over GitHub's 100 MB limit).
# The same file is inside the committed 4K-TV-Setup/VDD.Control.25.7.23.zip.
4K-TV-Setup/VDD-Control/VDD Control.exe
